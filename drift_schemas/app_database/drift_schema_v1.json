  "fixed_sql": [
    {
      "name": "wallets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"wallets\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"currency_code\" TEXT NOT NULL, \"initial_balance_minor\" INTEGER NOT NULL, \"color_argb\" INTEGER NOT NULL, \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), \"created_at_millis\" INTEGER NOT NULL, \"updated_at_millis\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (length(trim(name)) > 0), CHECK (currency_code GLOB '[A-Z][A-Z][A-Z]'), CHECK (color_argb BETWEEN 0 AND 4294967295), CHECK (is_archived IN (0, 1)), CHECK (created_at_millis > 0), CHECK (updated_at_millis >= created_at_millis));"
        }
      ]
    },
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"color_argb\" INTEGER NOT NULL, \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), \"created_at_millis\" INTEGER NOT NULL, \"updated_at_millis\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (length(trim(name)) > 0), CHECK (color_argb BETWEEN 0 AND 4294967295), CHECK (is_archived IN (0, 1)), CHECK (created_at_millis > 0), CHECK (updated_at_millis >= created_at_millis));"
        }
      ]
    },
    {
      "name": "transactions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transactions\" (\"id\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"amount_minor\" INTEGER NOT NULL, \"wallet_id\" TEXT NOT NULL REFERENCES wallets (id) ON DELETE RESTRICT, \"category_id\" TEXT NOT NULL REFERENCES categories (id) ON DELETE RESTRICT, \"occurred_on\" TEXT NOT NULL, \"note\" TEXT NULL, \"created_at_millis\" INTEGER NOT NULL, \"updated_at_millis\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (type IN ('income', 'expense')), CHECK (amount_minor > 0), CHECK (occurred_on GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'), CHECK (created_at_millis > 0), CHECK (updated_at_millis >= created_at_millis));"
        }
      ]
    },
    {
      "name": "transfers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transfers\" (\"id\" TEXT NOT NULL, \"source_wallet_id\" TEXT NOT NULL REFERENCES wallets (id) ON DELETE RESTRICT, \"destination_wallet_id\" TEXT NOT NULL REFERENCES wallets (id) ON DELETE RESTRICT, \"source_amount_minor\" INTEGER NOT NULL, \"destination_amount_minor\" INTEGER NOT NULL, \"occurred_on\" TEXT NOT NULL, \"note\" TEXT NULL, \"created_at_millis\" INTEGER NOT NULL, \"updated_at_millis\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (source_wallet_id != destination_wallet_id), CHECK (source_amount_minor > 0), CHECK (destination_amount_minor > 0), CHECK (occurred_on GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'), CHECK (created_at_millis > 0), CHECK (updated_at_millis >= created_at_millis));"
        }
      ]
    },
